<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <TargetFramework>net9.0</TargetFramework>
    <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
    <AssemblyName>libavalonia_ohos_app</AssemblyName>
    <OutputType Condition="'$(OpenHarmonyBuild)' != 'true'">Exe</OutputType>
    <NativeLib Condition="'$(OpenHarmonyBuild)' == 'true'">Shared</NativeLib>
    <PublishAot Condition="'$(OpenHarmonyBuild)' == 'true'">true</PublishAot>
    <InvariantGlobalization Condition="'$(OpenHarmonyBuild)' == 'true'">true</InvariantGlobalization>
    <DefineConstants Condition="'$(OpenHarmonyBuild)' == 'true'">$(DefineConstants);OHOS</DefineConstants>
  </PropertyGroup>
  <ItemGroup>
    <ProjectReference Include="../../src/Avalonia.OpenHarmony/Avalonia.OpenHarmony.csproj"/>
    <PackageReference Include="Avalonia.Themes.Simple" Version="[$(AvaloniaVersion)]"/>
    <PackageReference Include="SkiaSharp.NativeAssets.Linux" Version="[3.119.4]" Condition="'$(OpenHarmonyBuild)' == 'true'" ExcludeAssets="all"/>
    <PackageReference Include="HarfBuzzSharp.NativeAssets.Linux" Version="[8.3.1.3]" Condition="'$(OpenHarmonyBuild)' == 'true'" ExcludeAssets="all"/>
    <PackageReference Include="SkiaSharp.NativeAssets.Win32" Version="[3.119.4]" Condition="'$(OpenHarmonyBuild)' != 'true' and $([MSBuild]::IsOSPlatform('Windows'))"/>
    <PackageReference Include="HarfBuzzSharp.NativeAssets.Win32" Version="[8.3.1.3]" Condition="'$(OpenHarmonyBuild)' != 'true' and $([MSBuild]::IsOSPlatform('Windows'))"/>
  </ItemGroup>
  <Import Project="$(OpenHarmonyNetRoot)/toolchain/host-portable/OpenHarmonyRuntimePack.targets" Condition="'$(OpenHarmonyBuild)' == 'true'"/>
  <Import Project="$(OpenHarmonyNetRoot)/toolchain/host-portable/OpenHarmonyCross.targets" Condition="'$(OpenHarmonyBuild)' == 'true'"/>
  <Target Name="UseOpenHarmonyLinkerFromPathOnWindows" AfterTargets="ConfigureOpenHarmonyToolchain"
          Condition="$([MSBuild]::IsOSPlatform('Windows'))">
    <PropertyGroup>
      <CppCompilerAndLinker>clang++.exe</CppCompilerAndLinker>
      <CppLinker>$(CppCompilerAndLinker)</CppLinker>
    </PropertyGroup>
  </Target>
</Project>
